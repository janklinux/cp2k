# 18_pg-32  (sg #155, R32 / P3121 / P3221 / P3112 / P3212 / P312 / P321)
# MP material: mp-362  formula: Ni3S2  n_sites: 5
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Ni3S2_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   4.0304114800 -0.0240523400 0.0622603800
      B   0.0609346500 4.0300227200 0.0622603700
      C   -0.0245627400 -0.0240523400 4.0308179000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Ni  0.2452097100 0.7547902900 0.5000000000
      Ni  0.5000000000 0.2452097100 0.7547902900
      Ni  0.7547902900 0.5000000000 0.2452097100
      S   0.2540389500 0.2540389500 0.2540389500
      S   0.7459610500 0.7459610500 0.7459610500
    &END COORD
    &KIND Ni
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND S
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
