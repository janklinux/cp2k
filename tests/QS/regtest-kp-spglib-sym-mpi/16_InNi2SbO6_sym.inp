# 16_pg-3  (sg #146, R3 / P31 / P32 / P3)
# MP material: mp-1078367  formula: InNi2SbO6  n_sites: 10
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT InNi2SbO6_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   -2.6432190000 -4.5781790000 0.0011180000
      B   2.6430530000 -4.5781770000 0.0006860000
      C   -0.0004430000 -3.0530510000 4.7472690000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      In  0.7942950000 0.7943170000 0.6170590000
      Ni  0.0016180000 0.0016420000 0.9951140000
      Ni  0.5068060000 0.5067990000 0.4795330000
      Sb  0.3040600000 0.3040450000 0.0878630000
      O   0.2135200000 0.9161380000 0.2831970000
      O   0.9161280000 0.5871330000 0.2832240000
      O   0.5871030000 0.2135380000 0.2831920000
      O   0.6978380000 0.1171500000 0.8000450000
      O   0.1172220000 0.3849880000 0.8000440000
      O   0.3849820000 0.6978210000 0.8000200000
    &END COORD
    &KIND In
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Ni
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Sb
      BASIS_SET SZV-MOLOPT-SR-GTH
