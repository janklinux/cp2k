# 02_pg-bar1  (sg #2, P-1)
# MP material: mp-29443  formula: PI2  n_sites: 6
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT PI2_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   4.5115500100 0.0458400100 1.2804742900
      B   0.8440486100 7.1862131400 1.1904471700
      C   0.0315525300 0.0327491800 7.4940741300
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      P   0.5968323800 0.1350703600 0.9635147600
      P   0.4031676200 0.8649296400 0.0364852400
      I   0.4395245900 0.2261026800 0.6680442600
      I   0.5604754100 0.7738973200 0.3319557400
      I   0.1924666300 0.3012201800 0.1905966500
      I   0.8075333700 0.6987798200 0.8094033500
    &END COORD
    &KIND I
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND P
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
