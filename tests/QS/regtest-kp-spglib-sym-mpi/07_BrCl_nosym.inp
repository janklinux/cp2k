# 07_pg-mm2  (sg #36, Pna21 / Cmc21 / Pmc21 / Pmn21 / Pmm2 / etc)
# MP material: mp-1066781  formula: BrCl  n_sites: 4
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT BrCl_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   2.5150690000 -4.0255360000 0.0000000000
      B   2.5150690000 4.0255360000 0.0000000000
      C   0.0000000000 0.0000000000 7.8211230000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Br  0.0061430000 0.0061430000 0.3734760000
      Br  0.9938570000 0.9938570000 0.8734760000
      Cl  0.7174940000 0.7174940000 0.6265240000
      Cl  0.2825060000 0.2825060000 0.1265240000
    &END COORD
    &KIND Br
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Cl
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
