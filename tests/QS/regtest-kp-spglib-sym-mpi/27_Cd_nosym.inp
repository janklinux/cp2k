# 27_pg-6/mmm  (sg #194, P63/mmc / P63/mcm / P6/mcc / P6/mmm)
# MP material: mp-94  formula: Cd  n_sites: 2
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Cd_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   2.9584744100 0.0000000200 -0.0000000000
      B   -1.4792381800 2.5621143800 0.0000000000
      C   -0.0000000000 0.0000000000 5.8859279300
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Cd  0.3333330000 0.6666670000 0.2500000000
      Cd  0.6666670000 0.3333330000 0.7500000000
    &END COORD
    &KIND Cd
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
