# 23_pg-6/m  (sg #176, P63/m / P6/m)
# MP material: mp-23225  formula: BBr3  n_sites: 8
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT BBr3_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   6.5729477300 0.0001156900 0.0000000000
      B   -3.2865754900 5.6922822600 -0.0000000000
      C   -0.0000000000 0.0000000000 7.0350939500
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      B   0.3333330000 0.6666670000 0.2500000000
      B   0.6666670000 0.3333330000 0.7500000000
      Br  0.0552056600 0.3673654400 0.2500000000
      Br  0.6878412200 0.0552056600 0.7500000000
      Br  0.3673654400 0.3121587800 0.7500000000
      Br  0.6326355600 0.6878412200 0.2500000000
      Br  0.3121587800 0.9447943400 0.2500000000
      Br  0.9447943400 0.6326355600 0.7500000000
    &END COORD
    &KIND B
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Br
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
