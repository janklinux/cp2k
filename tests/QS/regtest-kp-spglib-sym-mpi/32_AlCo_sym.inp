# 32_pg-mbar3m  (sg #221, Fm-3m / Pm-3m / Pn-3m / Pm-3n / Pn-3n / Fm-3c / Fd-3m / Fd-3c / Im-3m / Ia-3d)
# MP material: mp-284  formula: AlCo  n_sites: 2
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT AlCo_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   2.8194032100 -0.0000000000 -0.0000000000
      B   -0.0000000000 2.8194032100 -0.0000000000
      C   0.0000000000 0.0000000000 2.8194032100
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Al  -0.0000000000 -0.0000000000 -0.0000000000
      Co  0.5000000000 0.5000000000 0.5000000000
    &END COORD
    &KIND Al
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Co
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
