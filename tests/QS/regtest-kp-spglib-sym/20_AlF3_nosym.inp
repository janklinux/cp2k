# 20_pg-bar3m  (sg #167, R-3m / R-3c / P-31m / P-31c / P-3m1 / P-3c1)
# MP material: mp-468  formula: AlF3  n_sites: 8
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT AlF3_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   1.4997710700 4.0163176800 7.6555210900
      B   -2.7702682200 4.0051863600 5.0207074400
      C   -1.4791383300 -4.0045656400 -2.6366807500
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Al  0.4999131100 0.7501376800 0.0001192200
      Al  0.4999865000 0.2499672800 -0.0001656500
      F   0.4128115600 -0.0002700700 0.8251630000
      F   0.0000146800 0.9119728700 0.4117825000
      F   0.4118098500 0.0881884400 0.4116344700
      F   0.5876363000 0.5002699100 0.1757406400
      F   0.0000414000 0.5873981800 0.5878210900
      F   0.5877875900 0.4123367200 0.5879047300
    &END COORD
    &KIND Al
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND F
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
