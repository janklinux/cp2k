# 13_pg-4mm  (sg #99, P4mm / I4mm / I41md / I41cd / etc)
# MP material: mp-545522  formula: CoBiO3  n_sites: 5
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT CoBiO3_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   3.7244499700 0.0000000000 0.0000000000
      B   0.0000000000 3.7244379400 0.0000000000
      C   0.0000000000 0.0000000000 4.0208322700
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Co  0.5000000000 0.5000000000 0.6228065600
      Bi  -0.0000000000 -0.0000000000 0.0509553300
      O   0.5000000000 -0.0000000000 0.6960848700
      O   0.5000000000 0.5000000000 0.1625723100
      O   0.0000000000 0.5000000000 0.6960809200
    &END COORD
    &KIND Bi
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Co
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
