# 04_pg-m  (sg #8, Cm / Cc / Pm / Pc)
# MP material: mp-550751  formula: BaBeSiO4  n_sites: 7
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT BaBeSiO4_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   4.4558430000 0.0170350000 2.5220010000
      B   1.4736080000 4.2862670000 2.5344660000
      C   -0.0145680000 -0.0270480000 5.1928950000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Ba  0.0267010000 0.9865450000 0.9865460000
      Be  0.2639630000 0.2520120000 0.2520120000
      Si  0.5150590000 0.5007740000 0.5007740000
      O   0.4401280000 0.3758380000 0.8781200000
      O   0.8890700000 0.3285550000 0.3285550000
      O   0.4401260000 0.8781200000 0.3758360000
      O   0.2856530000 0.4271560000 0.4271580000
    &END COORD
    &KIND Ba
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Be
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Si
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
