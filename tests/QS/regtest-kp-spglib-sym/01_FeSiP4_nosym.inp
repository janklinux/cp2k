# 01_pg-1  (sg #1, P1)
# MP material: mp-9198  formula: Fe(SiP)4  n_sites: 9
# Variant: nosym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT FeSiP4_nosym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID ON
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY OFF
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   4.5262922300 0.0011024600 1.7929767600
      B   1.8180045000 5.2114699700 0.4488661400
      C   0.0014734200 -0.0024570700 6.0546581000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Fe  -0.0003934900 -0.0001174200 0.0000264100
      Si  0.6803670400 0.7770352300 0.2170646500
      Si  0.2382160300 0.3383172600 0.4310671300
      Si  0.3459071600 0.5992464600 0.8852341700
      Si  0.8466210800 0.9713308800 0.6971789700
      P   0.1564186700 0.0114639200 0.3092527300
      P   0.6334675200 0.3998733000 0.1179853000
      P   0.7635004400 0.6419880200 0.5645958700
      P   0.3290945500 0.2191603400 0.7683937800
    &END COORD
    &KIND Fe
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND P
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Si
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
