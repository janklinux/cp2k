# 03_pg-2  (sg #4, P21 / P2 / C2)
# MP material: mp-5707  formula: CsAsF4  n_sites: 12
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT CsAsF4_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
