# 12_pg-422  (sg #98, P43212 / P41212 / I422 / I4122 / P422 / P4322 / P42212 / P4222 / P4122 / P4212)
# MP material: mp-471  formula: CdAs2  n_sites: 6
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT CdAs2_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   4.3633544600 0.0000000000 1.8145967100
      B   2.1816777400 5.6838078700 0.9072988600
      C   -0.0008474500 0.0000000000 6.1553694600
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Cd  0.2500000000 0.5000000000 0.5000000000
      Cd  0.0000000000 -0.0000000000 -0.0000000000
      As  0.6867069200 0.1882930800 0.6882930800
      As  0.6250000000 0.8117069200 0.6882930800
      As  0.5632930800 0.8117069200 0.3117069200
      As  0.1250000000 0.1882930800 0.3117069200
    &END COORD
    &KIND As
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Cd
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
