# 17_pg-bar3  (sg #148, R-3 / P-3)
# MP material: mp-1078114  formula: ReCl6  n_sites: 7
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ReCl6_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   -3.0483739700 -5.2784744000 -0.0005899500
      B   3.0487701200 -5.2786365700 -0.0002079000
      C   0.0005582300 -3.5187832400 5.5517885100
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Re  -0.0000000000 0.0000000000 -0.0000000000
      Cl  0.3820929200 0.7689101500 0.7629415900
      Cl  0.7689242700 0.0859526700 0.7629189600
      Cl  0.0860424000 0.3820238200 0.7629512500
      Cl  0.6179070800 0.2310898500 0.2370584100
      Cl  0.2310757300 0.9140473300 0.2370810400
      Cl  0.9139576000 0.6179761800 0.2370487500
    &END COORD
    &KIND Cl
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Re
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
