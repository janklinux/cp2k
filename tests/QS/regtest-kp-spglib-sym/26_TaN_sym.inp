# 26_pg-bar6m2  (sg #189, P-6m2 / P-6c2 / P-62m / P-62c)
# MP material: mp-1279  formula: TaN  n_sites: 6
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT TaN_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   5.2084957500 0.0000000000 0.0000000000
      B   -2.6042473700 4.5106893400 -0.0000000000
      C   0.0000000000 -0.0000000000 2.9147477500
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      Ta  0.0000000000 -0.0000000000 0.0000000000
      Ta  0.3333330000 0.6666670000 0.5000000000
      Ta  0.6666670000 0.3333330000 0.5000000000
      N   0.3923921700 -0.0000000000 0.0000000000
      N   0.6076078300 0.6076078300 -0.0000000000
      N   -0.0000000000 0.3923921700 0.0000000000
    &END COORD
    &KIND N
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND Ta
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
