# 21_pg-6  (sg #173, P6 / P61 / P65 / P62 / P64 / P63)
# MP material: mp-27529  formula: PI3  n_sites: 8
# Variant: sym
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT PI3_sym
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      EPS_GEO 1.e-8
      FULL_GRID OFF
      PARALLEL_GROUP_SIZE 0
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY ON
      VERBOSE F
    &END KPOINTS
    &MGRID
      CUTOFF 280
      REL_CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 8
      CHOLESKY OFF
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &MIXING
        ALPHA 0.40
        METHOD BROYDEN_MIXING
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 300
      &END SMEAR
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A   7.2746038000 0.0000298900 -0.0000000000
      B   -3.6373287700 6.2999773000 -0.0000000000
      C   0.0000000000 0.0000000000 7.6392014800
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED
      P   0.6666670000 0.3333330000 0.6384745100
      P   0.3333330000 0.6666670000 0.1384745100
      I   0.3455779000 0.3070059100 0.5025091600
      I   0.6544221000 0.6929940900 0.0025091600
      I   0.3070059100 0.9614270100 0.0025091600
      I   0.9614270100 0.6544221000 0.5025091600
      I   0.6929940900 0.0385729900 0.5025091600
      I   0.0385729900 0.3455779000 0.0025091600
    &END COORD
    &KIND I
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND
    &KIND P
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PADE
    &END KIND

  &END SUBSYS
&END FORCE_EVAL
